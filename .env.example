# MQTT Broker
MQTT_HOST=localhost
MQTT_PORT=1883
TOPIC_TELEMETRY=arduino/telemetry
TOPIC_COMMAND=arduino/command

# Flask
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false

# Arduino
#Windows for example: COM3, COM4... Linux: /dev/ttyUSB0 or /dev/ttyACM0
SERIAL_PORT=COM3
SERIAL_BAUD=9600
RECONNECT_DELAY=5